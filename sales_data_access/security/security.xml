<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_sale_team_leader" model="res.groups">
        <field name="name">User: Team Leader</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <!-- put in the sales team category tapi karena udah implied gausa -->
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]" /> 
        <!-- if ur in this group u are also a sales person -->
    </record>

    <!-- so that it will stay as a dropdown not a checklist -->
    <record id="sales_team.group_sale_salesman_all_leads" model="res.groups">
        <!-- <field name="name">User: All Documents</field> -->
        <field name="implied_ids" eval="[(4, ref('group_sale_team_leader'))]" />
    </record>

    <record id="sale_order_team_leader_rule" model="ir.rule">
        <field name="name">Sales Orders of Team Members</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[(4, ref('sales_data_access.group_sale_team_leader'))]"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('team_id.user_id', '=', user.id)]</field>
    </record>
</odoo>