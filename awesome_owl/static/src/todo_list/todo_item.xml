<templates xml:space="preserve">
  <t t-name="awesome_owl.TodoItem">
    <div class="border rounded p-2 m-1"
        t-att-class="{
        'text-muted text-decoration-line-through': props.todo.isCompleted
        }">
        <input type="checkbox"
               t-att-id="props.todo.id"
               t-att-checked="props.todo.isCompleted"
               t-on-change="onChange" />      
        <strong>#<t t-esc="props.todo.id"/>:</strong>
        <span><t t-esc="props.todo.description"/></span>
    </div>

    <span class="fa fa-remove text-danger cursor-pointer"
            t-on-click="onRemove"/>
  </t>
</templates>
