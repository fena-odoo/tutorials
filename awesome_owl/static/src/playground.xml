<!-- awesome_owl/static/src/playground.xml -->
<templates xml:space="preserve">
    <t t-name="awesome_owl.Playground">
        <h3 class="text-center">Double Counter</h3>
        <div class="d-flex justify-content-around">
            <Counter onChange.bind="updateA"/>
            <Counter onChange.bind="updateB"/>
            <p class="mt-4">Total Sum: <t t-esc="total"/>
            </p>
        </div>

        <h3 class="text-center mb-3">Cards Showcase</h3>
        <div class="d-flex flex-wrap justify-content-center">
            <Card title="'Title 1'" content="'Just plain text content.'"/>
            <Card title="'Title 2'" content="htmlContent"/>
            <Card title="'Title 3'" content="plainText"/>
            <Card title="'Title 4'"/>
        </div>

        <div class="text-center p-4">
            <h2>TodoList in Owl Playground:</h2>
            <TodoList/>
        </div>
    </t>
</templates>
