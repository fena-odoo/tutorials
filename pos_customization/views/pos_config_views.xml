<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_pos_config_form_inherit" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.congrats</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']" position="after">
                <group class="o_row">
                    <field name="congratulatory_text"/>
                </group>
                <!-- <setting string="ePos Printer" help="Connect device to your PoS without an IoT Box">
                    <field name="congratulatory_text" />
                </setting> -->
            </xpath>
        </field>
    </record>
</odoo>
