<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">
  <t t-name="pos_customization.OrderlineTrashButton" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">

    <xpath expr="//li[contains(@class, 'orderline')]" position="inside">
      <div class="position-absolute mt-4 end-0 p-2">
        <button class="btn btn-sm btn-outline-danger" t-on-click="removeLine">🗑️</button>
      </div>
    </xpath>

  </t>
</templates>
