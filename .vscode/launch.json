        "args": [
          "--addons-path=/home/odoo/odoo/addons,/home/odoo/tutorials/, /home/odoo/enterprise/",
          "-d", "rd-demo",
          "-u custom_contacts_report",
          "--log-level=debug"

        ]
      }
    ]
}