<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="contact_report_template">
        <t t-call="web.html_container">
            <div class="page">
                <h2>Contact Report</h2>

                <table class="table table-sm o_main_table" style="width: 100%; border-collapse: collapse;" border="1">
                    <thead>
                        <tr>
                            <th style="padding: 5px;">Name</th>
                            <th style="padding: 5px;">Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="partner">
                            <tr>
                                <td style="padding: 5px;"><span t-field="partner.name"/></td>
                                <td style="padding: 5px;"><span t-field="partner.email"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>
