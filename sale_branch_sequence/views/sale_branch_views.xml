<!-- views/sale_branch_views.xml -->
<odoo>
    <record id="view_sale_branch_list" model="ir.ui.view">
        <field name="name">sale.branch.list</field>
        <field name="model">sale.branch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="sequence_id"/>
            </list>
        </field>
    </record>

    <record id="view_sale_branch_form" model="ir.ui.view">
        <field name="name">sale.branch.form</field>
        <field name="model">sale.branch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_sale_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">sale.branch</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sale_settings_root" name="Settings" parent="sale.sale_menu_root" sequence="30"/>

    <menuitem id="menu_sale_branch" name="Branches"
              parent="menu_sale_settings_root"
              action="action_sale_branch"/>
</odoo>
