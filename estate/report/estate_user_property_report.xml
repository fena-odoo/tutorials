<odoo>
    <!-- Main template: User Property Report -->
    <template id="report_user_properties">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="doc">
                    <div class="page">
                        <h2>Salesperson: <t t-esc="doc.name"/></h2>

                        <t t-foreach="doc.property_ids" t-as="property">
                            <div class="mt-4">
                                <h3><t t-esc="property.name"/></h3>
                                <p>
                                    Expected Price: <t t-esc="property.expected_price"/><br/>
                                    State: <t t-esc="property.state"/>
                                </p>

                                <t t-set="offers" t-value="property.offer_ids"/>
                                <t t-call="estate.property_offer_table"/>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
