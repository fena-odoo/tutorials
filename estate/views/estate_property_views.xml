<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Search View -->
    <record id="view_estate_property_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <field name="name"/>
                <field name="state"/>

                <!-- Filters -->
                <filter string="Include archived" name="archived" domain="['|', ('active', '=', True), ('active', '=', False)]"/>
                <separator/>
                <filter string="Archived Only" name="archived_only" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="New Properties" name="new_only" domain="[('state', '=', 'new')]"/>

                <!-- Group By -->
                <group expand="1" string="Group By">
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_garden" string="Garden" context="{'group_by': 'garden'}"/>
                    <filter name="group_by_bedrooms" string="Bedrooms" context="{'group_by': 'bedrooms'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List view -->
    <record id="view_estate_property_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_estate_property_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <sheet>
                    <!-- Ribbon to indicate sold properties -->
                    <!-- <widget name="web_ribbon" title="Sold" bg_color="bg-success" attrs="{'invisible': [('selling_price', '=', 0.0)]}"/> -->

                    <!-- Title section -->
                    <group>
                        <!-- <h1> -->
                        <field name="name"/>
                        <field name="description"/>
                        <!-- </h1> -->
                    </group>

                    <!-- General fields -->
                    <group>
                        <group>
                            <field name="postcode"/>
                            <field name="expected_price"/>
                            <field name="bedrooms"/>
                            <field name="facades"/>
                            <field name="garden"/>
                            <field name="garden_orientation"/>
                        </group>
                        <group>
                            <field name="date_availability"/>
                            <field name="selling_price"/>
                            <field name="living_area"/>
                            <field name="garage"/>
                            <field name="garden_area"/>
                        </group>
                    </group>

                    <!-- Conditional garden fields -->
                    <!-- <group attrs="{'invisible': [('garden', '=', False)]}">
                    </group> -->
                </sheet>
            </form>
        </field>
    </record>


    <!-- Action -->
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_estate_property_search"/>
    </record>
</odoo>
