<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Search View -->
    <record id="view_estate_property_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <field name="name"/>
                <field name="property_type_id"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="facades"/>
                <field name="state"/>

                <!-- Filters -->
                <!-- <filter string="Include archived" name="archived" domain="['|', ('active', '=', True), ('active', '=', False)]"/>
                <separator/>
                <filter string="Archived Only" name="archived_only" domain="[('active', '=', False)]"/>
                <separator/> -->
                <filter string="New Properties" name="new_only" domain="[('state', '=', 'new')]"/>
                <filter string="Offer Received" name="offer_received_only" domain="[('state', '=', 'offer_received')]"/>

                <!-- Group By -->
                <group expand="1" string="Group By">
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_postcode" string="Postcode" context="{'group_by': 'postcode'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List view -->
    <record id="view_estate_property_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="property_type_id"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability"/>
                <field name="tag_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_estate_property_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="action_mark_sold" string="Mark as Sold" type="object" class="btn btn-primary" icon="fa-check" invisible="state in ('sold', 'cancelled')"/>

                    <button name="action_cancel_property" string="Cancel" type="object" class="btn btn-secondary" icon="fa-times" invisible="state in ('sold', 'cancelled')"/>
                </header>

                <sheet>
                    <!-- Title section -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" class="mb16"/>
                        </h1>
                    </div>

                    <!-- Top two columns: postcode/date & expected/selling -->
                    <group>
                        <group>
                            <field name="state" readonly="1"/>
                            <field name="property_type_id"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_price" readonly="1"/>
                            <field name="selling_price"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                    </group>

                    <!-- Notebook with Description tab -->
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area"/>
                                <field name="garden_orientation"/>
                                <field name="total_area" readonly="1"/>
                            </group>
                        </page>

                        <page string="Offers">
                            <field name="offer_ids" context="{'default_partner_id': uid}">
                                <list editable="bottom">
                                    <!-- <list> -->
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name="validity"/>
                                    <field name="date_deadline"/>
                                    <field name="status"/>
                                    <!-- Accept button -->
                                    <button name="action_accept_offer" type="object" icon="fa-check" string="Accept" invisible="status == 'accepted'"/>

                                    <!-- Reject button -->
                                    <button name="action_refuse_offer" type="object" icon="fa-times" string="Refuse" invisible="status == 'refused'"/>

                                </list>
                                <form>
                                    <group>
                                        <field name="price"/>
                                        <field name="partner_id"/>
                                        <field name="validity"/>
                                        <field name="date_deadline"/>
                                        <field name="status"/>
                                        <!-- Accept button -->
                                        <button name="action_accept_offer" type="object" icon="fa-check" attrs="{'invisible': [('status', '=', 'accepted')]}" string="Accept"/>

                                        <!-- Reject button -->
                                        <button name="action_refuse_offer" type="object" icon="fa-times" attrs="{'invisible': [('status', '=', 'refused')]}" string="Refuse"/>
                                    </group>
                                </form>
                            </field>
                        </page>


                        <page string="Contacts">
                            <group>
                                <field name="buyer_id"/>
                                <field name="salesperson_id"/>
                            </group>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>



    <!-- Action -->
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_estate_property_search"/>
    </record>
</odoo>
